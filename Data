   "source": [
    "## 3. Cboe (VIX OHLC)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "484d435f-cb60-4fa7-97c7-607eda1bb327",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "VIX_cboe_raw: 6782 rows, 2000-01-03 -> 2026-10-30, NaN: 0\n"
     ]
    }
   ],
   "source": [
    "try:\n",
    "    vix = pd.read_csv(CBOE_VIX_URL, storage_options=HEADERS)\n",
    "    vix.columns = [c.strip().title() for c in vix.columns]     # DATE -> Date, CLOSE -> Close, ...\n",
    "    vix[\"Date\"] = pd.to_datetime(vix[\"Date\"])\n",
    "    vix = vix.set_index(\"Date\").sort_index().loc[START:END]\n",
    "    save_raw(vix, \"VIX_cboe_raw\")\n",
    "except Exception as e:\n",
    "    print(\"Cboe download failed; use FRED VIXCLS or yfinance ^VIX instead:\", e)\n",
    "    "
   ]
